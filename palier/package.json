{
  "name": "palier",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "probe:rentila": "node --env-file=.env scripts/probe-rentila.mjs",
    "stripe:setup": "node --env-file=.env scripts/stripe-setup.mjs",
    "reset:bridge-user": "node --env-file=.env scripts/reset-bridge-user.mjs",
    "probe:enablebanking": "node --env-file=.env scripts/probe-enablebanking.mjs",
    "virements": "node --env-file=.env scripts/fetch-virements.mjs",
    "push:env:dry-run": "AZURE_WEBAPP_NAME=Novagentic HEALTH_URL=https://palier.novagentic.fr/api/health ENV_FILE=$PWD/.env bash ../scripts/push-app-settings.sh --dry-run",
    "push:env": "AZURE_WEBAPP_NAME=Novagentic HEALTH_URL=https://palier.novagentic.fr/api/health ENV_FILE=$PWD/.env bash ../scripts/push-app-settings.sh",
    "pull:env:dry-run": "AZURE_WEBAPP_NAME=Novagentic ENV_FILE=$PWD/.env bash ../scripts/push-app-settings.sh --pull --dry-run",
    "pull:env": "AZURE_WEBAPP_NAME=Novagentic ENV_FILE=$PWD/.env bash ../scripts/push-app-settings.sh --pull"
  },
  "dependencies": {
    "mongoose": "^8.9.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.7",
    "present": "^1.0.0",
    "scripts": "^0.1.0",
    "stripe": "^17.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
