# These are read by Nuxt's runtimeConfig (server/*), which only auto-maps
# NUXT_-prefixed env vars to the camelCase keys in nuxt.config.ts
# (NUXT_MONGODB_URI -> runtimeConfig.mongodbUri) — same convention
# Novagentic_group uses. Un-prefixed names here will silently NOT reach the
# app; confirmed the hard way during the initial smoke test.

# --- Database -----------------------------------------------------------
# MongoDB Atlas connection string. One cluster; the app splits data into two
# logical databases on it (`core`, `rent_sync`) — see server/utils/db.ts.
NUXT_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# --- Secrets at rest ------------------------------------------------------
# Encrypts each org's Rentila client_secret (and anything else stored per-
# tenant) before it touches Mongo. Generate with: openssl rand -base64 32
NUXT_ENCRYPTION_KEY=

# --- Auth (nuxt-auth-utils) ------------------------------------------------
# Encrypts the session cookie. 32+ chars. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- App URL ----------------------------------------------------------------
# Used to build Stripe Checkout success/cancel redirect URLs. No trailing slash.
NUXT_APP_URL=http://localhost:3000

# --- Bridge API (bank aggregation) ----------------------------------------
# ONE app registration for the whole platform — every landlord org becomes a
# Bridge "user" underneath this app, not a separate Bridge app each.
# Sandbox and production are just different Client-Id/Client-Secret pairs
# from your Bridge dashboard; same base URL (verify this still holds before
# going live — see README).
NUXT_BRIDGE_CLIENT_ID=
NUXT_BRIDGE_CLIENT_SECRET=
# Set when you create the webhook in the Bridge dashboard; used to verify
# the BridgeApi-Signature header on every incoming webhook. Never accept an
# unverified webhook — see server/api/webhooks/bridge.post.ts.
NUXT_BRIDGE_WEBHOOK_SECRET=

# --- Enable Banking (bank aggregation, France — fast alternative to Bridge) -
# Bridge's production access needs a completed KYB (Bridge sends a KYB link
# — see support.bridgeapi.io/hc/en-150/articles/22854214914322); until that
# clears, Enable Banking's "Restricted Production" mode gives real, live
# (non-sandbox) API access with NO KYB/contract at all, as long as the app
# only ever links accounts you connect yourself — see enablebanking.com/docs/faq.
# That's exactly this use case (landlord's own bank), not a general-purpose
# multi-tenant substitute for Bridge — full production for other people's
# accounts still needs their KYB later.
#
# Setup:
#   1. Sign up at https://enablebanking.com and create an Application in
#      the Control Panel.
#   2. Generate a keypair + self-signed cert and upload the .crt there:
#        openssl genrsa -out enablebanking-private.key 4096
#        openssl req -new -x509 -days 365 -key enablebanking-private.key -out enablebanking-public.crt \
#          -subj "/C=FR/ST=./L=./O=RentilaSync/CN=rentila-sync"
#      (-subj skips the interactive prompts; values are arbitrary, Enable
#      Banking only uses the cert for its public key, not to check the DN)
#      Uploading the cert gives you the application_id below.
#   3. In the Control Panel, under your application, "link" your own bank
#      account (the Restricted Production activation step) — this is what
#      unlocks live access without KYB.
#   4. Base64 the private key into one line (real newlines don't survive
#      Node's --env-file parsing, same reason other multi-line secrets in
#      this app get base64'd):
#        base64 -w0 enablebanking-private.key
NUXT_ENABLEBANKING_APPLICATION_ID=
NUXT_ENABLEBANKING_PRIVATE_KEY_B64=

# --- Stripe (billing) ------------------------------------------------------
# Live keys have real charging power — prefer sk_test_... while building/
# testing the checkout flow, only swap to sk_live_... when actually ready
# to accept real subscriptions. See README "Security notes".
NUXT_STRIPE_SECRET_KEY=
# Set after creating the webhook endpoint in the Stripe dashboard (or via
# `stripe listen` locally) — verifies the Stripe-Signature header, see
# server/api/webhooks/stripe.post.ts.
NUXT_STRIPE_WEBHOOK_SECRET=
# Output by `npm run stripe:setup` (creates the €3/mo Product+Price).
NUXT_STRIPE_PRICE_ID=

# --- Rentila --------------------------------------------------------------
# Per-organization credentials (each landlord brings their own) live
# encrypted in Mongo, not here. These two are ONLY for the standalone
# `npm run probe:rentila` script (plain Node, reads process.env directly —
# NOT routed through Nuxt runtimeConfig, so no NUXT_ prefix needed here) —
# your own personal MERMOZ account, for ad-hoc "what does this endpoint
# actually return" checks during dev.
RENTILA_CLIENT_ID=
RENTILA_CLIENT_SECRET=
