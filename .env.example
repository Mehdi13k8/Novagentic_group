# Azure Communication Services Email (server/api/contact.post.ts).
# Maps to Nuxt runtimeConfig via the NUXT_ prefix.

# Connection string from the Communication Services resource (Keys blade).
NUXT_ACS_CONNECTION_STRING=

# Verified sender address on the custom domain (novagentic.fr) linked to the
# Email Communication Service. DoNotReply@novagentic.fr is the default
# MailFrom address and works without extra setup; switch to a custom one
# (e.g. contact@novagentic.fr) once you can add it under MailFrom addresses.
NUXT_ACS_SENDER_ADDRESS=DoNotReply@novagentic.fr

# Recipients
NUXT_CONTACT_TO=contact@novagentic.fr
NUXT_CONTACT_CC=andremartin719@gmail.com,mehdi.rhoulam@outlook.fr
